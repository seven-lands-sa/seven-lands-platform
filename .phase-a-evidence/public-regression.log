="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4.5" width="18" height="15" rx="2.4"></rect><path d="M3 8.5h18" stroke-opacity="0.5"></path><circle cx="5.6" cy="6.5" r="0.5" fill="currentColor"></circle><path d="M6 12.5h6.5M6 15.8h4" stroke-opacity="0.65"></path><path d="M15.4 15.9h3.8"></path><circle cx="17.3" cy="12.4" r="1.4"></circle></svg></span><svg viewBox="0 0 20 20" aria-hidden="true" class="h-[1.05em] w-[1.05em] shrink-0 transition-transform duration-200 ease-[cubic-bezier(0.22,0.61,0.36,1)] group-hover/btn:translate-x-1 rtl:group-hover/btn:-translate-x-1 rtl:-scale-x-100 text-steel-600" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10h11"></path><path d="M10.5 4.8 15.7 10l-5.2 5.2"></path></svg></span><span class="display-3 !text-[1.1875rem]">Web, Commerce &amp; Digital Experiences</span><span class="text-[0.9375rem] leading-relaxed text-steel-600">A website that explains your service clearly and moves the customer to the next step.</span></a></li><li><a class="group flex flex-col gap-3 rounded-[1rem] border border-ink-950/12 bg-white p-5 transition-colors duration-200 hover:border-ink-950/30" data-analytics="service_cta_click" data-analytics-location="lands_mobile" href="/en/services/software-automation-technology"><span class="flex items-center justify-between gap-4"><span class="flex items-center gap-3"><span class="num text-[0.8125rem] font-semibold text-muted">07</span><svg viewBox="0 0 24 24" class="h-6 w-6 shrink-0 h-5 w-5 text-navy-800" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="4.5" width="7" height="7" rx="1.8"></rect><rect x="13.5" y="12.5" width="7" height="7" rx="1.8"></rect><path d="M10.5 8h2.6a2 2 0 0 1 2 2v2.5"></path><path d="M14.2 11.6 15.1 13l1.5-.6" stroke-opacity="0.7"></path><path d="M6.8 11.5v3.2a2 2 0 0 0 2 2h2.4" stroke-opacity="0.5"></path></svg></span><svg viewBox="0 0 20 20" aria-hidden="true" class="h-[1.05em] w-[1.05em] shrink-0 transition-transform duration-200 ease-[cubic-bezier(0.22,0.61,0.36,1)] group-hover/btn:translate-x-1 rtl:group-hover/btn:-translate-x-1 rtl:-scale-x-100 text-steel-600" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10h11"></path><path d="M10.5 4.8 15.7 10l-5.2 5.2"></path></svg></span><span class="display-3 !text-[1.1875rem]">Software, Automation &amp; Technology</span><span class="text-[0.9375rem] leading-relaxed text-steel-600">Systems and automation that cut manual work and connect the tools you already run on.</span></a></li></ul></div></div></div></section><section class="section-y bg-offwhite"><div class="container-x"><div class="grid gap-x-10 gap-y-5 md:grid-cols-12"><div class="md:col-span-5"><p class="eyebrow mb-4">The reality</p><h2 id="problems-heading" class="display-2 max-w-[22ch] text-balance">We start from the problem, not the service name.</h2></div><div class="md:col-span-6 md:col-start-7"><p class="lede measure">Four situations we meet constantly. If one of them sounds like your business, that&#x27;s the right door in.</p></div></div><ol class="mt-14 grid gap-px overflow-hidden rounded-[1.25rem] border border-ink-950/10 bg-ink-950/10 md:grid-cols-2" role="list"><li class="flex flex-col bg-white p-7 md:p-9"><span class="num text-[0.75rem] font-semibold text-muted">01</span><h3 class="display-3 mt-5 max-w-[26ch]">Your brand doesn&#x27;t match the level of your work?</h3><p class="mt-4 flex-1 text-[0.9375rem] leading-[1.9] text-steel-600">We put identity, message and experience in order before adding more noise.</p><p class="mt-6 border-t border-ink-950/10 pt-4"><a class="group inline-flex items-center gap-2 text-[0.875rem] font-semibold text-navy-800 underline-offset-[6px] hover:underline" data-analytics="service_cta_click" data-analytics-location="problems" href="/en/services/branding-creative"><span>Related capability: Branding &amp; Creative</span><svg viewBox="0 0 20 20" aria-hidden="true" class="h-[1.05em] w-[1.05em] shrink-0 transition-transform duration-200 ease-[cubic-bezier(0.22,0.61,0.36,1)] group-hover/btn:translate-x-1 rtl:group-hover/btn:-translate-x-1 rtl:-scale-x-100" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10h11"></path><path d="M10.5 4.8 15.7 10l-5.2 5.2"></path></svg></a></p></li><li class="flex flex-col bg-white p-7 md:p-9"><span class="num text-[0.75rem] font-semibold text-muted">02</span><h3 class="display-3 mt-5 max-w-[26ch]">Campaigns run, but the results stay fuzzy?</h3><p class="mt-4 flex-1 text-[0.9375rem] leading-[1.9] text-steel-600">We connect campaigns to measurement, landing pages and what happens after the click.</p><p class="mt-6 border-t border-ink-950/10 pt-4"><a class="group inline-flex items-center gap-2 text-[0.875rem] font-semibold text-navy-800 underline-offset-[6px] hover:underline" data-analytics="service_cta_click" data-analytics-location="problems" href="/en/services/performance-acquisition"><span>Related capability: Performance &amp; Acquisition</span><svg viewBox="0 0 20 20" aria-hidden="true" class="h-[1.05em] w-[1.05em] shrink-0 transition-transform duration-200 ease-[cubic-bezier(0.22,0.61,0.36,1)] group-hover/btn:translate-x-1 rtl:group-hover/btn:-translate-x-1 rtl:-scale-x-100" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10h11"></path><path d="M10.5 4.8 15.7 10l-5.2 5.2"></path></svg></a></p></li><li class="flex flex-col bg-white p-7 md:p-9"><span class="num text-[0.75rem] font-semibold text-muted">03</span><h3 class="display-3 mt-5 max-w-[26ch]">Your site exists but doesn&#x27;t help sales?</h3><p class="mt-4 flex-1 text-[0.9375rem] leading-[1.9] text-steel-600">We rebuild the experience around what a customer must understand and do.</p><p class="mt-6 border-t border-ink-950/10 pt-4"><a class="group inline-flex items-center gap-2 text-[0.875rem] font-semibold text-navy-800 underline-offset-[6px] hover:underline" data-analytics="service_cta_click" data-analytics-location="problems" href="/en/services/web-commerce-experiences"><span>Related capability: Web, Commerce &amp; Digital Experiences</span><svg viewBox="0 0 20 20" aria-hidden="true" class="h-[1.05em] w-[1.05em] shrink-0 transition-transform duration-200 ease-[cubic-bezier(0.22,0.61,0.36,1)] group-hover/btn:translate-x-1 rtl:group-hover/btn:-translate-x-1 rtl:-scale-x-100" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10h11"></path><path d="M10.5 4.8 15.7 10l-5.2 5.2"></path></svg></a></p></li><li class="flex flex-col bg-white p-7 md:p-9"><span class="num text-[0.75rem] font-semibold text-muted">04</span><h3 class="display-3 mt-5 max-w-[26ch]">Your team repeats the same work by hand?</h3><p class="mt-4 flex-1 text-[0.9375rem] leading-[1.9] text-steel-600">We look for where software and automation can save time and cut errors.</p><p class="mt-6 border-t border-ink-950/10 pt-4"><a class="group inline-flex items-center gap-2 text-[0.875rem] font-semibold text-navy-800 underline-offset-[6px] hover:underline" data-analytics="service_cta_click" data-analytics-location="problems" href="/en/services/software-automation-technology"><span>Related capability: Software, Automation &amp; Technology</span><svg viewBox="0 0 20 20" aria-hidden="true" class="h-[1.05em] w-[1.05em] shrink-0 transition-transform duration-200 ease-[cubic-bezier(0.22,0.61,0.36,1)] group-hover/btn:translate-x-1 rtl:group-hover/btn:-translate-x-1 rtl:-scale-x-100" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10h11"></path><path d="M10.5 4.8 15.7 10l-5.2 5.2"></path></svg></a></p></li></ol><div class="mt-12"><a class="group/btn inline-flex items-center justify-center gap-2.5 rounded-[12px] font-semibold transition-[background-color,color,border-color,transform] duration-200 ease-[cubic-bezier(0.22,0.61,0.36,1)] active:translate-y-px disabled:opacity-55 disabled:pointer-events-none border border-ink-950/25 text-ink-950 hover:border-ink-950/60 hover:bg-ink-950/[0.04] bg-transparent h-[3.25rem] px-7 text-base" href="/en/services"><span>Explore the seven capabilities</span><svg viewBox="0 0 20 20" aria-hidden="true" class="h-[1.05em] w-[1.05em] shrink-0 transition-transform duration-200 ease-[cubic-bezier(0.22,0.61,0.36,1)] group-hover/btn:translate-x-1 rtl:group-hover/btn:-translate-x-1 rtl:-scale-x-100" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10h11"></path><path d="M10.5 4.8 15.7 10l-5.2 5.2"></path></svg></a></div></div></section><section class="section-y bg-white"><div class="container-x"><div class="grid gap-x-10 gap-y-5 md:grid-cols-12"><div class="md:col-span-5"><p class="eyebrow mb-4">Our work</p><h2 id="work-heading" class="display-2 max-w-[22ch] text-balance">We document before we publish.</h2></div><div class="md:col-span-6 md:col-start-7"><p class="lede measure">We show the projects we can talk about with numbers, with the client&#x27;s agreement.</p><div class="mt-6 flex flex-wrap gap-3"><a class="group/btn inline-flex items-center justify-center gap-2.5 rounded-[12px] font-semibold transition-[background-color,color,border-color,transform] duration-200 ease-[cubic-bezier(0.22,0.61,0.36,1)] active:translate-y-px disabled:opacity-55 disabled:pointer-events-none border border-ink-950/25 text-ink-950 hover:border-ink-950/60 hover:bg-ink-950/[0.04] bg-transparent h-[3.25rem] px-7 text-base" href="/en/work"><span>The work page</span><svg viewBox="0 0 20 20" aria-hidden="true" class="h-[1.05em] w-[1.05em] shrink-0 transition-transform duration-200 ease-[cubic-bezier(0.22,0.61,0.36,1)] group-hover/btn:translate-x-1 rtl:group-hover/btn:-translate-x-1 rtl:-scale-x-100" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10h11"></path><path d="M10.5 4.8 15.7 10l-5.2 5.2"></path></svg></a></div></div></div><div class="mt-14 grid gap-8 md:grid-cols-12"><div class="md:col-span-7"><div class="relative overflow-hidden rounded-[1.25rem] border border-dashed border-ink-950/25 bg-offwhite p-8 md:p-10"><svg viewBox="0 0 1000 40" preserveAspectRatio="none" class="h-8 w-full opacity-70" fill="none" aria-hidden="true"><path d="M 0 26 Q 500 6 1000 22" stroke="rgba(6,20,40,0.16)" stroke-width="1.2"></path><circle cx="8" cy="26" r="3" fill="var(--color-navy-800)" fill-opacity="0.55"></circle><circle cx="254" cy="18.25" r="3" fill="var(--color-navy-800)" fill-opacity="0.55"></circle><circle cx="500" cy="15" r="3" fill="var(--color-navy-800)" fill-opacity="0.55"></circle><circle cx="746" cy="16.25" r="3" fill="var(--color-navy-800)" fill-opacity="0.55"></circle><circle cx="992" cy="22" r="3" fill="var(--color-navy-800)" fill-opacity="0.55"></circle></svg><p class="mt-3 max-w-[42ch] text-[0.9375rem] leading-[1.9] text-steel-600">Publishable projects are added to the work page.</p></div></div><div class="md:col-span-5"><ul class="flex flex-col divide-y divide-ink-950/10 border-y border-ink-950/10" role="list"><li class="flex gap-4 py-4"><span class="num text-[0.75rem] font-semibold text-muted">0<!-- -->1</span><span class="text-[0.9375rem] leading-[1.85] text-steel-600">Work is published after client approval, not before.</span></li><li class="flex gap-4 py-4"><span class="num text-[0.75rem] font-semibold text-muted">0<!-- -->2</span><span class="text-[0.9375rem] leading-[1.85] text-steel-600">Results are published once real data comes from the official accounts.</span></li><li class="flex gap-4 py-4"><span class="num text-[0.75rem] font-semibold text-muted">0<!-- -->3</span><span class="text-[0.9375rem] leading-[1.85] text-steel-600">If there&#x27;s nothing publishable yet, we simply say so.</span></li></ul></div></div></div></section><section class="section-y bg-offwhite"><div class="container-x"><div class="grid gap-x-10 gap-y-5 md:grid-cols-12"><div class="md:col-span-5"><p class="eyebrow mb-4">How we work</p><h2 id="process-heading" class="display-2 max-w-[22ch] text-balance">From the first session to a measurable next step.</h2></div><div class="md:col-span-6 md:col-start-7"><p class="lede measure">Four stages, no long process theatre.</p></div></div><div class="mt-16"><svg viewBox="0 0 1000 30" preserveAspectRatio="none" class="hidden h-8 w-full md:block" fill="none" aria-hidden="true"><path d="M 8 14 Q 500 4 992 16" stroke="var(--color-ink-950)" stroke-opacity="0.18" stroke-width="1.4" class="draw-path" style="--path-len:1000"></path><circle cx="8" cy="14" r="4" fill="var(--color-ice-400)" stroke="var(--color-ink-950)" stroke-width="1.4"></circle><circle cx="336" cy="9.777777777777779" r="4" fill="var(--color-ice-400)" stroke="var(--color-ink-950)" stroke-width="1.4"></circle><circle cx="664" cy="10.444444444444445" r="4" fill="var(--color-ice-400)" stroke="var(--color-ink-950)" stroke-width="1.4"></circle><circle cx="992" cy="16" r="4" fill="var(--color-ice-400)" stroke="var(--color-ink-950)" stroke-width="1.4"></circle></svg><ol class="grid gap-8 border-t border-ink-950/15 pt-8 md:grid-cols-4 md:gap-6" role="list"><li class="relative"><span class="num text-[0.75rem] font-semibold text-muted">01</span><h3 class="display-3 mt-4">Understand</h3><p class="mt-3 max-w-[34ch] text-[0.9375rem] leading-[1.9] text-steel-600">We start with the business, the market and the actual problem.</p></li><li class="relative"><span class="num text-[0.75rem] font-semibold text-muted">02</span><h3 class="display-3 mt-4">Plan</h3><p class="mt-3 max-w-[34ch] text-[0.9375rem] leading-[1.9] text-steel-600">We define priorities, channels and what truly needs to be built.</p></li><li class="relative"><span class="num text-[0.75rem] font-semibold text-muted">03</span><h3 class="display-3 mt-4">Build</h3><p class="mt-3 max-w-[34ch] text-[0.9375rem] leading-[1.9] text-steel-600">Creative, marketing and technology move together.</p></li><li class="relative"><span class="num text-[0.75rem] font-semibold text-muted">04</span><h3 class="display-3 mt-4">Measure &amp; improve</h3><p class="mt-3 max-w-[34ch] text-[0.9375rem] leading-[1.9] text-steel-600">We learn from real performance and iterate.</p></li></ol></div></div></section><section class="section-y bg-white"><div class="container-x"><div class="grid gap-x-10 gap-y-5 md:grid-cols-12"><div class="md:col-span-5"><p class="eyebrow mb-4">Why Seven Lands</p><h2 id="why-heading" class="display-2 max-w-[22ch] text-balance">Different disciplines. One decision.</h2></div><div class="md:col-span-6 md:col-start-7"><p class="lede measure">Nobody should manage five vendors to deliver one idea.</p></div></div><ul class="mt-14 grid gap-x-10 gap-y-10 md:grid-cols-2" role="list"><li class="grid gap-4 border-t border-ink-950/15 pt-6 sm:grid-cols-[auto_1fr] sm:gap-6"><span class="num text-[0.75rem] font-semibold text-muted">01</span><div><h3 class="text-[1.125rem] font-bold">One decision</h3><p class="mt-3 max-w-[46ch] text-[0.9375rem] leading-[1.9] text-steel-600">Message, design, campaign and technology run against a single commercial goal — not separate files.</p></div></li><li class="grid gap-4 border-t border-ink-950/15 pt-6 sm:grid-cols-[auto_1fr] sm:gap-6"><span class="num text-[0.75rem] font-semibold text-muted">02</span><div><h3 class="text-[1.125rem] font-bold">Business-first thinking</h3><p class="mt-3 max-w-[46ch] text-[0.9375rem] leading-[1.9] text-steel-600">Work is judged on what moves in the business: an enquiry, a sale, or hours returned to your team.</p></div></li><li class="grid gap-4 border-t border-ink-950/15 pt-6 sm:grid-cols-[auto_1fr] sm:gap-6"><span class="num text-[0.75rem] font-semibold text-muted">03</span><div><h3 class="text-[1.125rem] font-bold">Creative and technical, in one place</h3><p class="mt-3 max-w-[46ch] text-[0.9375rem] leading-[1.9] text-steel-600">Visual and technical work run together from day one, not as two separate handoffs.</p></div></li><li class="grid gap-4 border-t border-ink-950/15 pt-6 sm:grid-cols-[auto_1fr] sm:gap-6"><span class="num text-[0.75rem] font-semibold text-muted">04</span><div><h3 class="text-[1.125rem] font-bold">Local market understanding</h3><p class="mt-3 max-w-[46ch] text-[0.9375rem] leading-[1.9] text-steel-600">We work from Al Qassim and we know how Saudi customers behave and how they decide.</p></div></li></ul></div></section><section class="on-dark surface-dark relative overflow-hidden" aria-labelledby="final-cta-heading"><div aria-hidden="true" class="pointer-events-none absolute inset-0 opacity-[0.4]" style="background-image:linear-gradient(to right, rgba(245,247,248,0.05) 1px, transparent 1px), linear-gradient(to bottom, rgba(245,247,248,0.05) 1px, transparent 1px);background-size:72px 72px"></div><div class="container-x relative section-y"><svg viewBox="0 0 1000 40" preserveAspectRatio="none" class="h-8 w-full mb-12 opacity-60" fill="none" aria-hidden="true"><path d="M 0 26 Q 500 6 1000 22" stroke="rgba(245,247,248,0.22)" stroke-width="1.2"></path><circle cx="8" cy="26" r="3" fill="var(--color-ice-400)" fill-opacity="0.55"></circle><circle cx="172" cy="20.333333333333336" r="3" fill="var(--color-ice-400)" fill-opacity="0.55"></circle><circle cx="336" cy="16.666666666666668" r="3" fill="var(--color-ice-400)" fill-opacity="0.55"></circle><circle cx="500" cy="15" r="3" fill="var(--color-ice-400)" fill-opacity="0.55"></circle><circle cx="664" cy="15.333333333333332" r="3" fill="var(--color-ice-400)" fill-opacity="0.55"></circle><circle cx="828" cy="17.666666666666668" r="3" fill="var(--color-ice-400)" fill-opacity="0.55"></circle><circle cx="992" cy="22" r="3" fill="var(--color-ice-400)" fill-opacity="0.55"></circle></svg><div class="grid gap-